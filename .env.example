# Copy to .env and fill in. Never commit the real file.

# Pepper used to hash API keys. Generate one: openssl rand -base64 32
# Changing it invalidates every existing key.
TOPICAST_SECRET_KEY=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Group id (negative for supergroups), used by config.yaml
TELEGRAM_CHAT_ID=

# Optional: GitHub webhook secret, verified when set
GITHUB_WEBHOOK_SECRET=

# --- port and reachability ---
# The port is used inside the container and published on the host, so this one value is
# enough to move the service (for example if 8080 is already taken).
# TOPICAST_PORT=8080
# Who can reach it: 127.0.0.1 = this machine only (default), a VPN address = your tailnet,
# 0.0.0.0 = anyone who can route here. Docker publishes past UFW, so 0.0.0.0 means public.
# TOPICAST_BIND_ADDRESS=127.0.0.1

# --- optional tuning (defaults shown) ---
# TOPICAST_LOG_LEVEL=info
# TOPICAST_LOG_FORMAT=json          # json | console
# TOPICAST_DOCS_ENABLED=true        # serve /docs
# TOPICAST_METRICS_ENABLED=true     # serve /metrics
# TOPICAST_WAIT_TIMEOUT=30          # seconds for ?wait=true
# TOPICAST_MAX_UPLOAD_MB=50
# TOPICAST_RETENTION_DAYS=7
# TOPICAST_MAX_ATTEMPTS=5
